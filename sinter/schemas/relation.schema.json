{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "contentHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "extraction": {
          "enum": [
            "human",
            "extracted",
            "inferred"
          ],
          "title": "Extraction",
          "type": "string"
        }
      },
      "required": [
        "source",
        "locator",
        "extraction"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RelationMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "approved",
            "rejected",
            "deprecated",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "owners": {
          "items": {
            "type": "string"
          },
          "title": "Owners",
          "type": "array"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "domain"
      ],
      "title": "RelationMetadata",
      "type": "object"
    },
    "RelationSpec": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "type": {
          "const": "modernized_by",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "phase": {
          "enum": [
            "planned",
            "in-progress",
            "done"
          ],
          "title": "Phase",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "source",
        "type",
        "target",
        "phase",
        "evidence"
      ],
      "title": "RelationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "sinter.dev/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "Relation",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/RelationMetadata"
    },
    "spec": {
      "$ref": "#/$defs/RelationSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Relation",
  "type": "object"
}
